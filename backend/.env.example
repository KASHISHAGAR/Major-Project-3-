# ==== SERVER ====
PORT=5000
NODE_ENV=development

# ==== DATABASE ====
MONGO_URI=mongodb://127.0.0.1:27017/farmer_ecommerce

# ==== SESSION / COOKIES ====
SESSION_SECRET=replace_with_long_random_string
COOKIE_NAME=session_token
SESSION_TTL_DAYS=30

# ==== GOOGLE OAUTH ====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==== EMAIL (SMTP) ====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Farmer Marketplace <no-reply@farmermarketplace.com>"

# ==== FRONTEND ====
FRONTEND_URL=http://localhost:5173

# ==== OTP / SECURITY TUNING ====
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_WINDOW=5
PENDING_ACCOUNT_TTL_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=30

# ==== PAYMENTS (Razorpay) ====
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==== MARKETHUB PRICING ====
DEFAULT_SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999
TAX_RATE_PERCENT=0
